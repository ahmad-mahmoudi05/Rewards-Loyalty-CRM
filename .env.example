# Public base URL used to build absolute links (customer signup QR, etc).
# Falls back to the incoming request's own host if unset — see lib/site-url.ts.
NEXT_PUBLIC_APP_URL=

# Supabase (already configured for this project — see Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the client. See docs/architecture.md.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Day 5) — see docs/integrations.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email — Resend (Day 4)
RESEND_API_KEY=

# SMS — Twilio (Day 4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp — Meta WhatsApp Business Platform (Day 4)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Apple / Google Wallet (Day 3) — names finalized when implemented
