# Public base URL used to build absolute links (customer signup QR, etc).
# Falls back to the incoming request's own host if unset — see lib/site-url.ts.
NEXT_PUBLIC_APP_URL=

# Supabase (already configured for this project — see Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the client. See docs/architecture.md.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Day 5) — see docs/integrations.md and README.md "Deploying to production".
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is currently unused (Checkout/Portal are both
# server-redirect flows, no Stripe.js in the browser) — kept for a possible future
# embedded-Elements flow. Plan->Stripe Price mapping is NOT an env var: it's the
# `plans.stripe_price_id` column, set once per plan directly in the database after
# creating the real Products/Prices in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email — Resend (Day 4)
RESEND_API_KEY=
# From the Resend dashboard's Webhooks page, once a webhook endpoint is
# registered there. See docs/integrations.md.
RESEND_WEBHOOK_SECRET=

# SMS — Twilio (Day 4). Per-business accountSid/authToken/fromNumber are set
# via the dashboard (Integrations → SMS) and stored in
# business_integrations.config, not here — these top-level vars are unused
# by the app today but kept for a possible future platform-level fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp — Meta WhatsApp Business Platform (Day 4). Per-business
# phoneNumberId/wabaId/accessToken are set via the dashboard (Integrations →
# WhatsApp) and stored in business_integrations.config, not here.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
# Set to any secret string, then register it (and this deployment's
# /api/webhooks/meta URL) as the webhook verify token in the Meta App
# Dashboard. See docs/integrations.md.
META_WEBHOOK_VERIFY_TOKEN=
# Client-exposed (NEXT_PUBLIC_) — used only to launch Meta's Embedded Signup
# JS SDK from the browser; the actual token exchange stays server-side using
# META_APP_ID/META_APP_SECRET above. See
# components/dashboard/whatsapp-embedded-signup-button.tsx.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Time-based crons (/api/campaigns/process, /api/automations/run). Optional —
# if unset, both routes accept any caller (fine for local dev / manual
# triggering; set this before exposing either route publicly in production).
CRON_SECRET=

# Apple Wallet (Day 3) — architecture implemented, signing pending real
# certificates. See docs/integrations.md for exact steps to obtain these.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_WWDR_CERT=
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet (Day 3) — architecture implemented, JWT signing pending a
# real Google Cloud service account. See docs/integrations.md.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=
